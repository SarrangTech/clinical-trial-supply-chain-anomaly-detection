# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# See scripts/setup_aws.md for how to create the S3 bucket and the IAM user
# these credentials belong to.

# --- AWS S3 (Iceberg table storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=clinical-trial-supply-chain-anomaly-detection
S3_WAREHOUSE_PREFIX=warehouse

# --- Iceberg REST catalog (tabulario/iceberg-rest container) ---
ICEBERG_CATALOG_NAME=clinical_trials
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_CATALOG_JDBC_URI=jdbc:postgresql://postgres:5432/iceberg_catalog
ICEBERG_CATALOG_JDBC_USER=airflow
ICEBERG_CATALOG_JDBC_PASSWORD=airflow

# --- Postgres (Airflow metadata DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Spark ---
SPARK_MASTER_URL=spark://spark-master:7077

# --- FastAPI ---
API_KEY=dev-local-anomaly-api-key
WORKERS=1

# --- Anomaly detection thresholds (see docs/architecture.md for rationale) ---
COLD_CHAIN_BREACH_MINUTES=30
DOSING_WINDOW_DAYS=3
